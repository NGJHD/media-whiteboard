{
  "name": "media-whiteboard",
  "productName": "Media Whiteboard",
  "version": "0.1.0",
  "description": "Composite animated and static media onto a canvas and export an infinitely-looping animated WebP or GIF.",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "prepackage": "npm run fetch:ffmpeg && npm run build",
    "package": "electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json",
    "smoke:export": "node scripts/smoke-export.mjs",
    "smoke:import": "node scripts/smoke-import.mjs",
    "smoke": "npm run smoke:export && npm run smoke:import && npm run smoke:scene && npm run smoke:select && npm run smoke:timing && npm run smoke:tools && npm run smoke:transform && npm run smoke:preview",
    "smoke:scene": "node scripts/smoke-scene.mjs",
    "preview": "node scripts/preview-app.mjs",
    "smoke:select": "node scripts/smoke-select.mjs",
    "smoke:timing": "node scripts/smoke-timing.mjs",
    "smoke:tools": "node scripts/smoke-tools.mjs",
    "smoke:transform": "node scripts/smoke-transform.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "immer": "11.1.18",
    "konva": "10.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "19.2.5",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "zustand": "5.0.15"
  }
}
